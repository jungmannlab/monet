# .env.template — copy to `.env` in the monet package root and fill in.
#
# `.env` is gitignored and per-machine. monet loads it into the environment at
# import (python-dotenv, override=False — an already-exported variable or a
# systemd EnvironmentFile still wins). This replaces the deprecated env.yaml.
#
# NOTE on path lists: separate multiple paths with the OS path separator —
# ";" on Windows (the lab's microscope PCs), ":" on Linux/macOS. monet uses the
# first path that exists.

# --- config & protocol locations (were env.yaml: config_paths/protocol_paths) --
MONET_CONFIG_PATHS=Z:/users/you/powerbase/configs.yaml;Z:/y_Microscope_Infrastructure/powerbase/configs.yaml
MONET_PROTOCOL_PATHS=Z:/users/you/powerbase/protocols.yaml;Z:/y_Microscope_Infrastructure/powerbase/protocols.yaml

# --- authentication -----------------------------------------------------------
# Toggle: off | on | auto (default auto).
#   auto — enforce iff a token is configured (backward-compatible)
#   off  — no auth (loopback dev only); the client omits its token
#   on   — auth required (server refuses to start without tokens)
PAINT_MONET_AUTH=auto

# Client token (a microscope running calibrate/set/gui against an auth-enabled
# server). Use a WRITE-scoped token — the client reads AND writes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# PAINT_MONET_TOKEN=<this-rig-write-token>

# Server token map (only on the host running `monet serve`): comma/newline list
# of token:scope:label entries; scope is read|write; label is the holder.
# PAINT_MONET_TOKENS=<write-tok>:write:microscope-mercury,<read-tok>:read:dashboards
